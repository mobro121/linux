# ===========================
# Basic Fastfetch Config
# ===========================

# Enable/disable modules (1 = show, 0 = hide)
show_os=1
show_kernel=1
show_uptime=1
show_shell=1
show_cpu=1
show_gpu=1
show_ram=1
show_disk=1
show_packages=0
show_battery=0
show_host=0
show_de=1
show_wm=1
show_terminal=1
show_colors=1
show_logo=1

# Logo
logo=auto          # auto selects based on OS
logo_color=auto    # auto selects color based on OS

# Colors
key_color=yellow
value_color=white
title_color=cyan

# Alignment
alignment=left     # left, center, right

# Text formatting
bold_keys=1
underline_values=0
